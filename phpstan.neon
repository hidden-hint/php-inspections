includes:
    - extension.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        - tests/*/data/*
        - tests/*/*/data/*
        - tests/*/*/*/data/*
        - tests/*/Fixture/*
        - tests/*/*/Fixture/*
        - tests/CodingStandard/fixtures/*
        - tests/Rector/SharedConfig/fixtures/*
    ignoreErrors:
        -
            identifier: ergebnis.noNullableReturnTypeDeclaration
            path: src/Rector/*
    ergebnis:
        noExtends:
            classesAllowedToBeExtended:
                - PHPStan\Testing\RuleTestCase
                - Rector\Rector\AbstractRector
                - Rector\Testing\PHPUnit\AbstractRectorTestCase
