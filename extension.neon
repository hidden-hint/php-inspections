parameters:
    phpInspections:
        abbreviations:
            - e
            - ex
            - f
            - i
            - j
            - k
            - v
            - arr
            - str
            - obj
            - cnt
            - idx
            - tmp
            - val
            - res
            - req
            - resp
            - cb
            - fn
            - ctx
            - cfg
            - conf
            - msg
            - err
            - num
            - len
            - el
            - elem
            - buf
            - ptr
    ergebnis:
        noIsset:
            enabled: false
        noConstructorParameterWithDefaultValue:
            enabled: false
        noParameterWithNullDefaultValue:
            enabled: false

parametersSchema:
    phpInspections: structure([
        abbreviations: listOf(string())
    ])

rules:
    - HiddenHint\PhpInspections\PHPStan\Rules\MemoizedPropertyRule
    - HiddenHint\PhpInspections\PHPStan\Rules\YodaIdenticalComparisonRule

services:
    -
        class: HiddenHint\PhpInspections\PHPStan\Rules\TypedClassConstantRule
        tags:
            - phpstan.rules.rule
    - HiddenHint\PhpInspections\PHPStan\Rules\InheritedSignatureDetector
    -
        class: HiddenHint\PhpInspections\PHPStan\Rules\BooleanFlagParameterRule
        tags:
            - phpstan.rules.rule
    -
        class: HiddenHint\PhpInspections\PHPStan\Rules\ParameterDefaultValueRule
        tags:
            - phpstan.rules.rule
    -
        class: HiddenHint\PhpInspections\PHPStan\Rules\AbbreviatedNameRule
        arguments: %phpInspections.abbreviations%
        tags:
            - phpstan.rules.rule
    - HiddenHint\PhpInspections\PHPStan\Rules\EmptinessComparisonMatcher
    -
        class: HiddenHint\PhpInspections\PHPStan\Rules\CountEmptinessCheckRule
        tags:
            - phpstan.rules.rule
    -
        class: HiddenHint\PhpInspections\PHPStan\Rules\StrlenEmptinessCheckRule
        tags:
            - phpstan.rules.rule
